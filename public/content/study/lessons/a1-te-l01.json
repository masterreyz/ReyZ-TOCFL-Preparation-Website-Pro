  {"type": "heading", "id": "h-d1", "zh": "對話一", "en": "Dialogue I"},
  {"type": "dialogue", "id": "d1", "track": "01-01", "source": {"pages": [29, 30]},
   "lines": [
    {"spk": "明華", "zh": "請問你是陳月美小姐嗎？", "py": "Qǐngwèn nǐ shì Chén Yuèměi xiǎojiě ma?"},
    {"spk": "月美", "zh": "是的。謝謝你來接我們。", "py": "Shìde. Xièxie nǐ lái jiē wǒmen."},
    {"spk": "明華", "zh": "不客氣。我是李明華。", "py": "Búkèqì. Wǒ shì Lǐ Mínghuá."},
    {"spk": "月美", "zh": "這是王先生。", "py": "Zhè shì Wáng Xiānshēng."},
    {"spk": "開文", "zh": "你好。我姓王，叫開文。", "py": "Nǐ hǎo. Wǒ xìng Wáng, jiào Kāiwén."},
    {"spk": "明華", "zh": "你們好。歡迎你們來臺灣。", "py": "Nǐmen hǎo. Huānyíng nǐmen lái Táiwān."}
   ],
   "translation": [
    {"spk": "Minghua", "en": "Excuse me, are you Miss Chen Yuemei?"},
    {"spk": "Yuemei", "en": "Yes. Thank you for coming to pick us up."},
    {"spk": "Minghua", "en": "You're welcome. My name is Minghua Li."},
    {"spk": "Yuemei", "en": "This is Mr. Wang."},
    {"spk": "Kaiwen", "en": "Hi, my surname is Wang. My first name is Kaiwen."},
    {"spk": "Minghua", "en": "How are you? Welcome to Taiwan."}
   ]},
