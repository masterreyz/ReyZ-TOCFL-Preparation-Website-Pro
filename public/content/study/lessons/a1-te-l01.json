  {"type": "heading", "id": "h-d2", "zh": "對話二", "en": "Dialogue II"},
  {"type": "dialogue", "id": "d2", "track": "01-03", "source": {"pages": [31, 32]},
   "lines": [
    {"spk": "明華", "zh": "請喝茶。", "py": "Qǐng hē chá."},
    {"spk": "開文", "zh": "謝謝。很好喝。請問這是什麼茶？", "py": "Xièxie. Hěn hǎohē. Qǐngwèn zhè shì shénme chá?"},
    {"spk": "明華", "zh": "這是烏龍茶。臺灣人喜歡喝茶。", "py": "Zhè shì Wūlóng chá. Táiwān rén xǐhuān hē chá."},
    {"spk": "", "zh": "開文，你們日本人呢？", "py": "Kāiwén, nǐmen Rìběn rén ne?"},
    {"spk": "月美", "zh": "他不是日本人。", "py": "Tā bú shì Rìběn rén."},
    {"spk": "明華", "zh": "對不起，你是哪國人？", "py": "Duìbùqǐ, nǐ shì nǎ guó rén?"},
    {"spk": "開文", "zh": "我是美國人。", "py": "Wǒ shì Měiguó rén."},
    {"spk": "明華", "zh": "開文，你要不要喝咖啡？", "py": "Kāiwén, nǐ yào bú yào hē kāfēi?"},
    {"spk": "開文", "zh": "謝謝！我不喝咖啡，我喜歡喝茶。", "py": "Xièxie! Wǒ bù hē kāfēi, wǒ xǐhuān hē chá."}
   ],
   "translation": [
    {"spk": "Minghua", "en": "Please have some tea."},
    {"spk": "Kaiwen", "en": "Thank you. This tastes good. May I ask what kind of tea this is?"},
    {"spk": "Minghua", "en": "This is Oolong tea. Taiwanese like to drink tea. Kaiwen, how about you Japanese people?"},
    {"spk": "Yuemei", "en": "He is not Japanese."},
    {"spk": "Minghua", "en": "I am sorry. Which country are you from?"},
    {"spk": "Kaiwen", "en": "I am American."},
    {"spk": "Minghua", "en": "Kaiwen, would you like to drink coffee?"},
    {"spk": "Kaiwen", "en": "Thank you. I don't drink coffee. I like to drink tea."}
   ]},
