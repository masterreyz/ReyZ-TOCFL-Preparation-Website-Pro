{"testId":"pb-n-l2-2","segments":30,"englishComplete":true,"indonesianComplete":true,"questions":{"1":{"transcript":[{"zh":"(A) 這位先生和他太太。","py":"(A) zhèwèi xiānsheng hé tā tàitai.","en":"(A) This gentleman and his wife.","idn":"(A) Bapak ini dan istrinya."},{"zh":"(B) 這位先生和他同學。","py":"(B) zhèwèi xiānsheng hé tā tóngxué.","en":"(B) This gentleman and his classmate.","idn":"(B) Bapak ini dan teman sekelasnya."},{"zh":"(C) 這位先生和他孩子。","py":"(C) zhèwèi xiānsheng hé tā háizi.","en":"(C) This gentleman and his child.","idn":"(C) Bapak ini dan anaknya."}]},"2":{"transcript":[{"zh":"(A) 桌上有一些水果。","py":"(A) zhuōshàng yǒu yìxiē shuǐguǒ.","en":"(A) There is some fruit on the table.","idn":"(A) Di atas meja ada beberapa buah."},{"zh":"(B) 桌上有一些飲料。","py":"(B) zhuōshàng yǒu yìxiē yǐnliào.","en":"(B) There are some drinks on the table.","idn":"(B) Di atas meja ada beberapa minuman."},{"zh":"(C) 桌上有一些麵包。","py":"(C) zhuōshàng yǒu yìxiē miànbāo.","en":"(C) There is some bread on the table.","idn":"(C) Di atas meja ada beberapa roti."}]},"3":{"transcript":[{"zh":"(A) 他們在跳舞。","py":"(A) tāmen zài tiàowǔ.","en":"(A) They are dancing.","idn":"(A) Mereka sedang menari."},{"zh":"(B) 他們在唱歌。","py":"(B) tāmen zài chànggē.","en":"(B) They are singing.","idn":"(B) Mereka sedang bernyanyi."},{"zh":"(C) 他們在運動。","py":"(C) tāmen zài yùndòng.","en":"(C) They are exercising.","idn":"(C) Mereka sedang berolahraga."}]},"4":{"transcript":[{"zh":"(A) 他在等車。","py":"(A) tā zài děng chē.","en":"(A) He is waiting for a bus.","idn":"(A) Dia sedang menunggu kendaraan (bus)."},{"zh":"(B) 他在坐車。","py":"(B) tā zài zuòchē.","en":"(B) He is riding in a vehicle.","idn":"(B) Dia sedang naik kendaraan."},{"zh":"(C) 他在開車。","py":"(C) tā zài kāichē.","en":"(C) He is driving.","idn":"(C) Dia sedang menyetir mobil."}]},"5":{"transcript":[{"zh":"(A) 他在玩球。","py":"(A) tā zài wánqiú.","en":"(A) He is playing with a ball.","idn":"(A) Dia sedang bermain bola."},{"zh":"(B) 他站著玩。","py":"(B) tā zhànzhe wán.","en":"(B) He is playing standing up.","idn":"(B) Dia bermain sambil berdiri."},{"zh":"(C) 他和同學玩。","py":"(C) tā hé tóngxué wán.","en":"(C) He is playing with classmates.","idn":"(C) Dia bermain dengan teman sekelas."}]},"6":{"transcript":[{"zh":"(A) 這裡有一條路。","py":"(A) zhèlǐ yǒu yìtiáo lù.","en":"(A) There is a road here.","idn":"(A) Di sini ada sebuah jalan."},{"zh":"(B) 這裡有一張紙。","py":"(B) zhèlǐ yǒu yìzhāng zhǐ.","en":"(B) There is a sheet of paper here.","idn":"(B) Di sini ada selembar kertas."},{"zh":"(C) 這裡有一隻雞。","py":"(C) zhèlǐ yǒu yìzhī jī.","en":"(C) There is a chicken here.","idn":"(C) Di sini ada seekor ayam."}]},"7":{"transcript":[{"zh":"(A) 小孩吃麵。","py":"(A) xiǎohái chī miàn.","en":"(A) The child is eating noodles.","idn":"(A) Anak itu makan mi."},{"zh":"(B) 小孩喝牛奶。","py":"(B) xiǎohái hēniúnǎi.","en":"(B) The child is drinking milk.","idn":"(B) Anak itu minum susu."},{"zh":"(C) 小孩吃巧克力。","py":"(C) xiǎohái chī Qiǎokèlì.","en":"(C) The child is eating chocolate.","idn":"(C) Anak itu makan cokelat."}]},"8":{"transcript":[{"zh":"(A) 這裡有衣服和床。","py":"(A) zhèlǐ yǒu yīfú Héchuáng.","en":"(A) There are clothes and a bed here.","idn":"(A) Di sini ada baju dan tempat tidur."},{"zh":"(B) 椅子下面有一本書。","py":"(B) yǐzi xiàmiàn yǒu yì běnshū.","en":"(B) There is a book under the chair.","idn":"(B) Di bawah kursi ada sebuah buku."},{"zh":"(C) 桌子上面有一杯咖啡。","py":"(C) zhuōzi shàngmiàn yǒu yìbēi kāfēi.","en":"(C) There is a cup of coffee on the table.","idn":"(C) Di atas meja ada secangkir kopi."}]},"9":{"transcript":[{"zh":"(A) 姊姊比弟弟高。","py":"(A) zǐzǐ bǐ dìdi gāo.","en":"(A) Older sister is taller than younger brother.","idn":"(A) Kakak perempuan lebih tinggi daripada adik laki-laki."},{"zh":"(B) 姊姊在吃東西。","py":"(B) zǐzǐ zài chī Dōngxi.","en":"(B) Older sister is eating something.","idn":"(B) Kakak perempuan sedang makan sesuatu."},{"zh":"(C) 姊姊沒穿鞋子。","py":"(C) zǐzǐ méi chuān xiézi.","en":"(C) Older sister isn't wearing shoes.","idn":"(C) Kakak perempuan tidak memakai sepatu."}]},"10":{"transcript":[{"zh":"(A) 這是看電影的地方。","py":"(A) zhè shì kàn diànyǐng de dìfāng.","en":"(A) This is a place to watch movies.","idn":"(A) Ini tempat menonton film."},{"zh":"(B) 可以帶食物進去吃。","py":"(B) kěyǐ dài shíwù jìnqù chī.","en":"(B) You can bring food in to eat.","idn":"(B) Boleh membawa makanan masuk untuk dimakan."},{"zh":"(C) 這家店早上九點開。","py":"(C) zhèjiā diàn zǎoshàng jiǔdiǎn kāi.","en":"(C) This shop opens at nine in the morning.","idn":"(C) Toko ini buka pukul sembilan pagi."}]}}}