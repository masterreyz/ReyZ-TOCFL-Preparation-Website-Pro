{"testId":"pb-n-l1-2","segments":11,"englishComplete":true,"indonesianComplete":true,"questions":{"1":{"transcript":[{"zh":"兩杯水。","py":"Liǎngbēi shuǐ.","en":"Two glasses of water.","idn":"Dua gelas air."}]},"2":{"transcript":[{"zh":"中午了。","py":"Zhōngwǔ le.","en":"It's noon.","idn":"Sudah siang (tengah hari)."}]},"3":{"transcript":[{"zh":"一位先生。","py":"Yíwèi xiānsheng.","en":"A gentleman.","idn":"Seorang bapak (tuan)."}]},"4":{"transcript":[{"zh":"今天是弟弟的生日。","py":"Jīntiān shì dìdi de shēngrì.","en":"Today is younger brother's birthday.","idn":"Hari ini ulang tahun adik laki-laki."}]},"5":{"transcript":[{"zh":"他在打電話。","py":"Tā zài dǎdiànhuà.","en":"He is making a phone call.","idn":"Dia sedang menelepon."}]},"6":{"transcript":[{"zh":"她在買衣服。","py":"Tā zài mǎi yīfú.","en":"She is buying clothes.","idn":"Dia sedang membeli baju."}]},"7":{"transcript":[{"zh":"我有電腦。","py":"Wǒ yǒu diànnǎo.","en":"I have a computer.","idn":"Saya punya komputer."}]},"8":{"transcript":[{"zh":"他常常畫畫。","py":"Tā chángcháng huàhuà.","en":"He often draws pictures.","idn":"Dia sering menggambar."}]},"9":{"transcript":[{"zh":"他的工作是老師。","py":"Tā de gōngzuò shì lǎoshī.","en":"His job is teacher.","idn":"Pekerjaannya guru."}]},"10":{"transcript":[{"zh":"他在看書。","py":"Tā zài kànshū.","en":"He is reading a book.","idn":"Dia sedang membaca buku."}]},"11":{"transcript":[{"zh":"現在下雨了。","py":"Xiànzài xiàyǔ le.","en":"It's raining now.","idn":"Sekarang hujan."}]}}}