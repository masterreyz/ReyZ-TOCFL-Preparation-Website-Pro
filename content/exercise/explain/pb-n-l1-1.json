{"testId":"pb-n-l1-1","segments":20,"englishComplete":true,"indonesianComplete":true,"questions":{"1":{"transcript":[{"zh":"我要喝茶。","py":"Wǒ yào hēchá.","en":"I want to drink tea.","idn":"Saya mau minum teh."}]},"2":{"transcript":[{"zh":"這是我的書。","py":"Zhè shì wǒ de shū.","en":"This is my book.","idn":"Ini buku saya."}]},"3":{"transcript":[{"zh":"他早上八點起床。","py":"Tā zǎoshàng bādiǎn qǐchuáng.","en":"He gets up at eight in the morning.","idn":"Dia bangun pukul delapan pagi."}]},"4":{"transcript":[{"zh":"我只買了褲子。","py":"Wǒ zhǐ mǎi le kùzi.","en":"I only bought pants.","idn":"Saya hanya membeli celana."}]},"5":{"transcript":[{"zh":"這裡有三杯水。","py":"Zhèlǐ yǒu sānbēishuǐ.","en":"There are three glasses of water here.","idn":"Di sini ada tiga gelas air."}]},"6":{"transcript":[{"zh":"我的生日是七月十一號。","py":"Wǒ de shēngrì shì qīyuè shíyíhào.","en":"My birthday is July 11th.","idn":"Ulang tahun saya tanggal 11 Juli."}]},"7":{"transcript":[{"zh":"他在穿鞋子。","py":"Tā zài chuān xiézi.","en":"He is putting on his shoes.","idn":"Dia sedang memakai sepatu."}]},"8":{"transcript":[{"zh":"那裡有狗。","py":"Nàlǐ yǒu gǒu.","en":"There is a dog over there.","idn":"Di sana ada anjing."}]},"9":{"transcript":[{"zh":"他開車去學校。","py":"Tā kāichē qù xuéxiào.","en":"He drives to school.","idn":"Dia menyetir mobil ke sekolah."}]},"10":{"transcript":[{"zh":"王太太在醫院工作。","py":"Wáng tàitai zài yīyuàn gōngzuò.","en":"Mrs. Wang works at a hospital.","idn":"Nyonya Wang bekerja di rumah sakit."}]},"11":{"transcript":[{"zh":"現在是晚上。","py":"Xiànzài shì wǎnshàng.","en":"It is evening now.","idn":"Sekarang malam hari."}]},"12":{"transcript":[{"zh":"那裡是我的學校。","py":"Nàlǐ shì wǒ de xuéxiào.","en":"That is my school.","idn":"Itu sekolah saya."}]},"13":{"transcript":[{"zh":"林小姐在等朋友。","py":"Lín xiǎojiě zài děng péngyǒu.","en":"Miss Lin is waiting for a friend.","idn":"Nona Lin sedang menunggu teman."}]},"14":{"transcript":[{"zh":"這一雙鞋子太小了。","py":"Zhè yìshuāng xiézi tàixiǎo le.","en":"This pair of shoes is too small.","idn":"Sepasang sepatu ini terlalu kecil."}]},"15":{"transcript":[{"zh":"他玩得很高興。","py":"Tā wán de hěn gāoxìng.","en":"He is having a great time playing.","idn":"Dia bermain dengan sangat gembira."}]},"16":{"transcript":[{"zh":"他在讀書。","py":"Tā zài dúshū.","en":"He is studying.","idn":"Dia sedang belajar."}]},"17":{"transcript":[{"zh":"我有一塊錢。","py":"Wǒ yǒu yíkuàiqián.","en":"I have one dollar.","idn":"Saya punya satu dolar."}]},"18":{"transcript":[{"zh":"弟弟站在中間。","py":"Dìdi zhàn zài zhōngjiān.","en":"Younger brother is standing in the middle.","idn":"Adik laki-laki berdiri di tengah."}]},"19":{"transcript":[{"zh":"一個鐘頭。","py":"Yí ge zhōngtóu.","en":"One hour.","idn":"Satu jam."}]},"20":{"transcript":[{"zh":"這是公園。","py":"Zhè shì gōngyuán.","en":"This is a park.","idn":"Ini taman."}]}}}